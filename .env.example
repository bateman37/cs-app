# Copiar a .env y completar. Nunca versionar .env.
# Base de datos exclusiva de CS App (no reutilizar otras bases).
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/cs_app?schema=public"

# Solo para pruebas automáticas: base separada cuyo nombre acaba en _test.
TEST_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/cs_app_test?schema=public"

# Opcional: base exclusiva para "prisma migrate dev" (solo desarrollo de migraciones).
# SHADOW_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/cs_app_shadow?schema=public"

# Secreto de sesión: 32 caracteres o más, generado al azar (ver docs/arquitectura/base-web-y-setup.md).
BETTER_AUTH_SECRET=""

# URL pública de la aplicación (origen de confianza para las cookies y los formularios).
BETTER_AUTH_URL="http://localhost:3000"

# --- Motor de cargas (CSAPP-02). Todas opcionales; valores por defecto entre paréntesis.
# Directorio privado persistente de archivos subidos, compartido por web y trabajador (./almacen-cargas).
# CSAPP_UPLOAD_DIR="C:\datos\cs-app\almacen-cargas"

# CSAPP-09: almacén PRIVADO de exportaciones completas (separado de los originales; ./almacen-exportaciones). Vida útil, límites y partición:
# CSAPP_EXPORT_DIR="C:\datos\cs-app\exportaciones"
# CSAPP_EXPORT_TTL_HOURS=24
# CSAPP_EXPORT_MAX_ACTIVE_PER_USER=2
# CSAPP_EXPORT_PART_ROWS=1000000
# Límites: CSAPP_UPLOAD_MAX_BYTES (200 MB), CSAPP_UPLOAD_MAX_UNCOMPRESSED_BYTES (1 GB), CSAPP_UPLOAD_MAX_RATIO (200),
# CSAPP_UPLOAD_MAX_ROWS (5000000), CSAPP_UPLOAD_MAX_SHARED_STRINGS_BYTES (256 MB),
# CSAPP_UPLOAD_MAX_CONCURRENT (3 subidas simultáneas), CSAPP_UPLOAD_MAX_OPEN_BATCHES (20), CSAPP_UPLOAD_INCOMPLETE_MINUTES (60).
# Trabajador (CSAPP_WORKER_STOP_TIMEOUT_MS=120000 cierre ordenado máximo): CSAPP_WORKER_LEASE_MS (60000), CSAPP_WORKER_HEARTBEAT_MS (15000), CSAPP_WORKER_POLL_MS (2000),
# CSAPP_WORKER_MAX_ATTEMPTS (3), CSAPP_WORKER_CHUNK_ROWS (1000), CSAPP_WORKER_BACKOFF_MS (2000).
# SOLO en entornos de test: nombre exacto de la base de pruebas para habilitar los perfiles sintéticos.
# CSAPP_ENABLE_SYNTHETIC_PROFILES="cs_app_test"

# --- CSAPP-10 (operación). Catálogo completo en docs/operacion/variables-entorno.md.
# INSTALACIÓN OPERATIVA (NODE_ENV=production): CSAPP_UPLOAD_DIR y CSAPP_EXPORT_DIR son OBLIGATORIAS, absolutas, distintas y fuera de la carpeta de la aplicación;
# NO definir TEST_DATABASE_URL, SHADOW_DATABASE_URL ni CSAPP_ENABLE_SYNTHETIC_PROFILES (las opciones de prueba impiden el arranque operativo).
# CSAPP_PORT=3000 · CSAPP_HOST="127.0.0.1" · CSAPP_HOME="C:\\apps\\cs-app" · CSAPP_STATE_DIR="C:\\datos\\cs-app\\estado"
# CSAPP_HEALTH_WORKER_ALIVE_MS=45000 · CSAPP_HEALTH_STALL_MS=900000 · CSAPP_HEALTH_QUEUE_AGE_MS=300000 · CSAPP_HEALTH_INSTANCE_HISTORY_MS=86400000
# CSAPP_OPERATIVA=1 · CSAPP_BUILD_SHA · CSAPP_WORKER_ID · CSAPP_CUENTA_CLAVE (solo en la sesión, nunca aquí)
# Interpretaciones de fuentes (CSAPP-04): CSAPP_BUG_TERMINAL_STATES="" · CSAPP_ZENDESK_HOSTS="" · CSAPP_DEVOPS_PRODUCTS=""
# Export/almacenes: CSAPP_EXPORT_PAGE_ROWS=5000 · CSAPP_EXPORT_MAX_ACTIVE_TOTAL=6 · CSAPP_EXPORT_MAX_ROWS=20000000 · CSAPP_EXPORT_MAX_FILE_BYTES=2147483648 · CSAPP_EXPORT_MIN_FREE_BYTES=268435456 · CSAPP_EXPORT_MATERIALIZE_TIMEOUT_MS=3600000 · CSAPP_WORKER_ACTIVATION_TIMEOUT_MS=1800000
# Solo pruebas: CSAPP_APPROVED_TEST_DB · CSAPP_COUNT_QUERIES

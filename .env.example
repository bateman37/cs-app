# Copiar a .env y completar. Nunca versionar .env.
# Base de datos exclusiva de CS App (no reutilizar otras bases).
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/cs_app?schema=public"

# Solo para pruebas automáticas: base separada cuyo nombre acaba en _test.
TEST_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/cs_app_test?schema=public"

# Opcional: base exclusiva para "prisma migrate dev" (solo desarrollo de migraciones).
# SHADOW_DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/cs_app_shadow?schema=public"

# Secreto de sesión: 32 caracteres o más, generado al azar (ver docs/arquitectura/base-web-y-setup.md).
BETTER_AUTH_SECRET=""

# URL pública de la aplicación (origen de confianza para las cookies y los formularios).
BETTER_AUTH_URL="http://localhost:3000"

# --- Motor de cargas (CSAPP-02). Todas opcionales; valores por defecto entre paréntesis.
# Directorio privado persistente de archivos subidos, compartido por web y trabajador (./almacen-cargas).
# CSAPP_UPLOAD_DIR="C:\datos\cs-app\almacen-cargas"
# Límites: CSAPP_UPLOAD_MAX_BYTES (200 MB), CSAPP_UPLOAD_MAX_UNCOMPRESSED_BYTES (1 GB), CSAPP_UPLOAD_MAX_RATIO (200),
# CSAPP_UPLOAD_MAX_ROWS (5000000), CSAPP_UPLOAD_MAX_SHARED_STRINGS_BYTES (256 MB),
# CSAPP_UPLOAD_MAX_CONCURRENT (3 subidas simultáneas), CSAPP_UPLOAD_MAX_OPEN_BATCHES (20), CSAPP_UPLOAD_INCOMPLETE_MINUTES (60).
# Trabajador: CSAPP_WORKER_LEASE_MS (60000), CSAPP_WORKER_HEARTBEAT_MS (15000), CSAPP_WORKER_POLL_MS (2000),
# CSAPP_WORKER_MAX_ATTEMPTS (3), CSAPP_WORKER_CHUNK_ROWS (1000), CSAPP_WORKER_BACKOFF_MS (2000).
# SOLO en entornos de test: nombre exacto de la base de pruebas para habilitar los perfiles sintéticos.
# CSAPP_ENABLE_SYNTHETIC_PROFILES="cs_app_test"

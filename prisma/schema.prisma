// Modelo físico: CSAPP-01 (acceso, maestros de clientes, vigencias, hitos y auditoría) y
// CSAPP-02 (personal, usuarios mensuales y motor común de cargas).
// Las restricciones que Prisma no expresa (exclusión de solapamientos, CHECK, índices
// únicos insensibles a mayúsculas) están en la migración SQL correspondiente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Acceso

enum UserRole {
  ADMIN
  CONSULTA
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(CONSULTA)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  audits            AuditEvent[]
  matrixMonths      UserMatrixMonth[]
  uploadsCreated    UploadBatch[]               @relation("UploadCreatedBy")
  uploadJobs        UploadJob[]
  exportJobs        ExportJob[]
  reconRuns         ReconRun[]
  zdDecisions       ZdTimeDecision[]
  zdCorrections     ZdTimeCorrection[]
  wrikeDecisions    WrikeTimeDecision[]
  wrikeCorrections  WrikeTimeCorrection[]
  workItemLinks     WorkItemLink[]
  financeDecisions  FinanceDecision[]
  settingsRevisions EconomicSettingsRevision[]
  configRevisions   ConfigRevision[]            @relation("ConfigRevisionActivatedBy")
  configDrafts      ConfigDraft[]               @relation("ConfigDraftUpdatedBy")
  healthUpdates     HealthFeedback[]            @relation("HealthUpdatedBy")
  healthEvents      HealthFeedbackEvent[]       @relation("HealthEventBy")
  qualityNotes      QualityNote[]               @relation("QualityNoteAuthor")
  coverageDecls     UploadCoverageDeclaration[] @relation("CoverageDeclaredBy")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ---------------------------------------------------------------- Maestros

enum ExternalSystem {
  BC
  ZENDESK
  WRIKE
  PAP
}

enum IdentityKind {
  GROUP_KEY
  ORG_ID
  ORG_NAME
  PROJECT_ID
  PROJECT_NAME
}

enum ServiceAttribute {
  SUPPORT
  HOSTING
  COMPLEXITY
  PRODUCT
}

enum MilestoneType {
  START
  CLOUD_MIGRATION
  MAJOR_VERSION
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
  INITIALIZE
  UPLOAD
  CONFIRM
  CANCEL
  ACTIVATE
  REVERT
  REPROCESS
}

/// Agrupación económica BC.
model ClientGroup {
  id             String   @id @default(cuid())
  name           String
  bcDenomination String?
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients      Client[]
  identities   ExternalIdentity[]
  terms        ServiceTerm[]
  milestones   Milestone[]
  userMatrices UserMatrix[]
  healthCells  HealthFeedback[]
  qualityNotes QualityNote[]
}

/// Identidad operativa (organización Zendesk). groupId nulo = grupo no asignado.
model Client {
  id         String   @id @default(cuid())
  groupId    String?
  name       String
  isInternal Boolean  @default(false)
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group           ClientGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  implementations Implementation[]
  identities      ExternalIdentity[]
  terms           ServiceTerm[]
  milestones      Milestone[]
  userMatrices    UserMatrix[]
  healthCells     HealthFeedback[]
  qualityNotes    QualityNote[]

  @@index([groupId])
}

/// Implantación identificada de un Cliente; solo existe si la fuente la identifica.
model Implementation {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  key       String?
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  identities   ExternalIdentity[]
  terms        ServiceTerm[]
  milestones   Milestone[]
  userMatrices UserMatrix[]

  @@index([clientId])
}

/// Catálogo explícito de productos.
model Product {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Equivalencia de origen. Vigencia [validFrom, validTo): validFrom inclusivo, validTo exclusivo;
/// un extremo nulo significa sin límite conocido por ese lado.
model ExternalIdentity {
  id               String         @id @default(cuid())
  system           ExternalSystem
  kind             IdentityKind
  rawValue         String
  searchValue      String
  groupId          String?
  clientId         String?
  implementationId String?
  validFrom        DateTime?      @db.Date
  validTo          DateTime?      @db.Date
  note             String?
  isActive         Boolean        @default(true)
  version          Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  group          ClientGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  implementation Implementation? @relation(fields: [implementationId], references: [id], onDelete: Restrict)

  @@index([system, kind, searchValue])
  @@index([groupId])
  @@index([clientId])
  @@index([implementationId])
}

/// Dato de servicio con vigencia [validFrom, validTo), en un único ámbito (grupo, cliente o implantación).
/// La ausencia de fila para una fecha significa «sin informar».
model ServiceTerm {
  id               String           @id @default(cuid())
  attribute        ServiceAttribute
  value            String
  groupId          String?
  clientId         String?
  implementationId String?
  validFrom        DateTime?        @db.Date
  validTo          DateTime?        @db.Date
  note             String?
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  group          ClientGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  implementation Implementation? @relation(fields: [implementationId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([clientId])
  @@index([implementationId])
}

model Milestone {
  id               String        @id @default(cuid())
  type             MilestoneType
  date             DateTime      @db.Date
  note             String?
  groupId          String?
  clientId         String?
  implementationId String?
  isActive         Boolean       @default(true)
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  group          ClientGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  implementation Implementation? @relation(fields: [implementationId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([clientId])
  @@index([implementationId])
}

model AuditEvent {
  id         String      @id @default(cuid())
  at         DateTime    @default(now())
  actorId    String
  actorEmail String
  action     AuditAction
  entityType String
  entityId   String
  /// Contexto para consultar el historial desde la ficha de grupo o de cliente.
  groupId    String?
  clientId   String?
  /// Contexto para el historial de una persona del maestro PERSONAL.
  personId   String?
  /// Contexto para el historial de un lote de Cargas.
  batchId    String?
  summary    String
  before     Json?
  after      Json?

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([groupId, at])
  @@index([clientId, at])
  @@index([personId, at])
  @@index([batchId, at])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------- CSAPP-02: personal

enum PersonSystem {
  PAP
  ZENDESK
  WRIKE
}

enum PersonAliasKind {
  NAME
  ID
  EMAIL
}

enum PersonAttribute {
  LEVEL
  TEAM
  PMO_MEMBER
  PMO_ROLE
}

enum StaffCatalogKind {
  LEVEL
  TEAM
  PMO_ROLE
}

/// Catálogo mínimo de nivel, equipo y rol PMO. Los roles iniciales (ANA, DEV) los siembra la migración.
model StaffCatalogItem {
  id        String           @id @default(cuid())
  kind      StaffCatalogKind
  name      String
  isActive  Boolean          @default(true)
  version   Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  terms PersonTerm[]
}

/// Maestro único de personas (PERSONAL y PERSONAL PMO). No son cuentas de acceso.
model Person {
  id        String   @id @default(cuid())
  name      String
  note      String?
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases PersonAlias[]
  terms   PersonTerm[]
}

/// Alias, ID o correo de una persona en un sistema. Vigencia [validFrom, validTo).
model PersonAlias {
  id          String          @id @default(cuid())
  personId    String
  system      PersonSystem
  kind        PersonAliasKind
  rawValue    String
  searchValue String
  validFrom   DateTime?       @db.Date
  validTo     DateTime?       @db.Date
  note        String?
  isActive    Boolean         @default(true)
  version     Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@index([system, kind, searchValue])
}

/// Nivel, equipo, pertenencia a PMO o rol PMO con vigencia [validFrom, validTo).
/// La ausencia de tramo para una fecha significa «sin informar».
model PersonTerm {
  id            String          @id @default(cuid())
  personId      String
  attribute     PersonAttribute
  catalogItemId String?
  flag          Boolean?
  validFrom     DateTime?       @db.Date
  validTo       DateTime?       @db.Date
  note          String?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  person      Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  catalogItem StaffCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([personId, attribute])
  @@index([catalogItemId])
}

// ---------------------------------------------------------------- CSAPP-02: usuarios contratados

enum UserValueKind {
  /// Carga inicial del histórico (base 2025). Ya no se bloquea por fila: edita la ventana año actual + anterior (HOTFIX-01 §7).
  INITIAL
  /// Base copiada del mismo mes del año anterior.
  COPIED
  /// Resultado de «aplicar desde este mes».
  PROPAGATED
  /// Ajuste explícito de un mes concreto.
  ADJUSTED
  /// HOTFIX-01 §7: valor estimado a partir de la base 2025 en años anteriores («Estimado a partir de 2025»); no es un dato observado.
  ESTIMATED
}

/// Matriz anual de usuarios que pagan de un ámbito (grupo, cliente o implantación).
/// Un mes sin fila en UserMatrixMonth es «sin informar»; una fila con valor 0 es un cero confirmado.
model UserMatrix {
  id               String   @id @default(cuid())
  groupId          String?
  clientId         String?
  implementationId String?
  year             Int
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group          ClientGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  implementation Implementation?   @relation(fields: [implementationId], references: [id], onDelete: Restrict)
  months         UserMatrixMonth[]

  @@index([groupId])
  @@index([clientId])
  @@index([implementationId])
}

model UserMatrixMonth {
  matrixId    String
  month       Int
  value       Int
  kind        UserValueKind
  isLocked    Boolean       @default(false)
  /// Procedencia legible: «Valor inicial indicado por el administrador», «Copia de 2025-03», etc.
  source      String
  revision    Int           @default(1)
  updatedById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  matrix    UserMatrix @relation(fields: [matrixId], references: [id], onDelete: Restrict)
  updatedBy User       @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([matrixId, month])
  @@index([updatedById])
}

// ---------------------------------------------------------------- CSAPP-02: motor común de cargas

enum UploadStatus {
  RECEIVING
  QUEUED
  PREPARING
  READY
  ACTIVATION_QUEUED
  ACTIVATING
  COMPLETED
  REJECTED
  FAILED
  CANCELLED
  REVERTED
}

enum UploadJobKind {
  PREPARE
  ACTIVATE
  REVERT
  /// Recalcula lo derivado (relaciones, atribución) de un lote ya completado, sin releer el archivo.
  REDERIVE
}

enum UploadJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum StagedClass {
  VALID
  ERROR
  EXCLUDED
}

/// Lote de carga: un archivo recibido, su estado, contadores y metadatos separados
/// (fecha de carga, extracción declarada y cobertura conocida).
model UploadBatch {
  id                     String       @id @default(cuid())
  profileId              String
  profileVersion         Int
  status                 UploadStatus @default(RECEIVING)
  statusDetail           String?
  originalName           String
  /// Identificador interno del archivo en el almacenamiento privado (nunca una ruta del navegador).
  storageId              String       @unique
  fileFormat             String
  sizeBytes              BigInt       @default(0)
  checksum               String?
  /// Metadatos que exige el perfil (por ejemplo, el ámbito a sustituir).
  metadata               Json         @default("{}")
  scopeKey               String?
  declaredExtractionDate DateTime?    @db.Date
  declaredFrom           DateTime?    @db.Date
  declaredTo             DateTime?    @db.Date
  coverageNote           String?

  phase               String?
  rowsProcessed       Int     @default(0)
  checkpointPosition  Int     @default(0)
  rowsReceived        Int     @default(0)
  rowsValid           Int     @default(0)
  rowsError           Int     @default(0)
  rowsReviewed        Int     @default(0)
  rowsDuplicate       Int     @default(0)
  rowsExcluded        Int     @default(0)
  rowsWarning         Int     @default(0)
  rowsImported        Int     @default(0)
  summary             Json?
  rulesSnapshot       String?
  /// Secuencia de recepción aceptada (HOTFIX-01 §4): la asigna el servidor al encolar el archivo completo. Entre lotes completados gana la mayor.
  receptionSeq        BigInt?
  /// Lote anterior al hotfix: sus tiempos forman la base heredada, que la primera instantánea completa nueva sustituye.
  legacyBase          Boolean @default(false)
  /// Para políticas de sustitución: lote al que sustituye y lote que lo sustituyó después.
  supersedesBatchId   String?
  supersededByBatchId String?
  cancelRequested     Boolean @default(false)

  createdById   String
  confirmedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  preparedAt    DateTime?
  confirmedAt   DateTime?
  finishedAt    DateTime?
  version       Int       @default(1)

  createdBy User                 @relation("UploadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  jobs      UploadJob[]
  rows      UploadStagedRow[]
  sources   UploadRecordSource[]

  zdTickets       ZdTicket[]
  zdRevisions     ZdTicketRevision[]
  zdObservations  ZdTicketObservation[]
  zdEntries       ZdTimeEntry[]
  zdCorrections   ZdTimeCorrection[]
  zdDecisions     ZdTimeDecision[]
  zdStamp         ZdPreviewStamp?
  zdTicketPreview ZdTicketPreview[]
  zdTimePreview   ZdTimePreview[]
  coverageDecls   UploadCoverageDeclaration[]

  wrikeEntries     WrikeTimeEntry[]
  wrikeCorrections WrikeTimeCorrection[]
  wrikeDecisions   WrikeTimeDecision[]
  papItems         PapItem[]
  papRevisions     PapRevision[]
  papObservations  PapObservation[]
  workItems        WorkItem[]
  workItemRevs     WorkItemRevision[]
  workItemObs      WorkItemObservation[]
  workItemEvidence WorkItemLinkEvidence[]

  financeBatch     FinanceBatch?
  financeDecisions FinanceDecision[]

  @@index([createdAt])
  @@index([profileId, status])
  @@index([profileId, scopeKey])
  @@index([checksum])
  @@index([profileId, status, receptionSeq])
}

/// Cola de trabajos en PostgreSQL. Reclamación atómica, lease con latido y token de fencing.
model UploadJob {
  id             String          @id @default(cuid())
  batchId        String
  kind           UploadJobKind
  status         UploadJobStatus @default(PENDING)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(3)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  /// Se incrementa en cada reclamación: un trabajador que perdió el trabajo no puede confirmar.
  fence          Int             @default(0)
  runAfter       DateTime        @default(now())
  lastError      String?
  /// Actor generado en servidor al encolar; el trabajador lo vuelve a autorizar.
  actorId        String
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actor User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([status, runAfter])
  @@index([batchId])
}

/// Staging: una fila fuente tal y como se leyó, tipada y clasificada. No altera datos activos.
model UploadStagedRow {
  id              BigInt      @id @default(autoincrement())
  batchId         String
  /// Posición correlativa de la fila de datos en el archivo (clave de reanudación).
  position        Int
  sheet           String?
  sourceRow       Int
  raw             Json
  typed           Json?
  fingerprint     String?
  entityKey       String?
  classification  StagedClass
  issues          Json?
  hasWarning      Boolean     @default(false)
  duplicateInFile Boolean     @default(false)
  /// Calculada en la activación: NEW, DUPLICATE_EXISTING, REVISION.
  disposition     String?
  /// Datos derivados de forma determinista del propio texto fuente (causas, referencias, candidatos). No entran en la huella.
  derived         Json?

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, position])
  @@index([batchId, classification])
  @@index([batchId, fingerprint])
}

/// Procedencia: qué lote aportó qué fila (por huella). Una fila idéntica se materializa una vez
/// aunque la aporten varios lotes; la reversión consulta esta tabla.
model UploadRecordSource {
  id            BigInt  @id @default(autoincrement())
  batchId       String
  profileId     String
  dedupeKey     String  @default("")
  fingerprint   String
  entityKey     String?
  occurrences   Int     @default(1)
  firstPosition Int

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, fingerprint])
  @@index([profileId, dedupeKey, fingerprint])
  @@index([profileId, dedupeKey, entityKey])
}

// ---------------------------------------------------------------- CSAPP-03: Zendesk tickets y tiempos

/// Ticket Zendesk: una entidad por ticket_id (exacto, texto). Los punteros currentRevisionId y
/// currentObservationId son de lectura y los mantiene el servicio (sin FK para evitar ciclos).
model ZdTicket {
  ticketId             String   @id
  firstBatchId         String
  currentRevisionId    BigInt?
  currentObservationId BigInt?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  firstBatch   UploadBatch           @relation(fields: [firstBatchId], references: [id], onDelete: Restrict)
  revisions    ZdTicketRevision[]
  observations ZdTicketObservation[]

  @@index([firstBatchId])
}

/// Revisión de contenido de un ticket: una por contenido funcional distinto (tags como conjunto).
model ZdTicketRevision {
  id                 BigInt   @id @default(autoincrement())
  ticketId           String
  /// Huella de la fila fuente tipada (el motor común); identifica el contenido funcional.
  fingerprint        String
  revisionNo         Int
  organizationId     String?
  entorno            String?
  causaRaiz          String?
  tags               String[] @default([])
  destinations       String[] @default([])
  createdOn          DateTime @db.Date
  createdTime        String?
  ticketType         String
  status             String
  typeKnown          Boolean
  statusKnown        Boolean
  adminDelegada      Boolean?
  /// Revisión anterior del mismo ticket cuando se creó (referencia informativa) y campos que cambian.
  previousRevisionId BigInt?
  changedFields      String[] @default([])
  batchId            String
  createdAtDb        DateTime @default(now())

  ticket       ZdTicket              @relation(fields: [ticketId], references: [ticketId], onDelete: Restrict)
  batch        UploadBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observations ZdTicketObservation[]

  @@unique([ticketId, fingerprint])
  @@unique([ticketId, revisionNo])
  @@index([batchId])
  @@index([organizationId])
  @@index([createdOn])
}

/// Observación: un lote vio este ticket con este contenido en una fecha de extracción declarada
/// (o de recepción, si no se declaró). Se conserva aunque el contenido no cambie.
model ZdTicketObservation {
  id           BigInt   @id @default(autoincrement())
  ticketId     String
  batchId      String
  revisionId   BigInt
  observedOn   DateTime @db.Date
  /// DECLARED = extracción declarada; RECEIVED = fecha de recepción (frescura desconocida).
  observedKind String
  receivedAt   DateTime
  createdAt    DateTime @default(now())

  ticket   ZdTicket         @relation(fields: [ticketId], references: [ticketId], onDelete: Restrict)
  batch    UploadBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  revision ZdTicketRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([batchId, ticketId])
  @@index([ticketId, observedOn])
  @@index([revisionId])
  @@index([observedOn, batchId])
}

/// Registro de tiempo materializado (uno por fila fuente distinta). Las columnas drv* son derivadas y se
/// recalculan sin releer el archivo; el contenido fuente solo cambia por una corrección explícita.
model ZdTimeEntry {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  originFingerprint String   @unique
  firstBatchId      String
  ticketId          String
  userId            String?
  userName          String?
  workDate          DateTime @db.Date
  hourText          String?
  loggedHours       Decimal
  loggedMinutes     Decimal
  /// Duración exacta en minutos: logged_hours × 60 + logged_minutes (se convierte a horas al agregar).
  minutes           Decimal
  dayLabel          String?
  segmenter         String?
  sourceId          String?
  channel           String?
  /// Huella del contenido vigente (distinta de originFingerprint tras una corrección).
  fingerprint       String
  revision          Int      @default(1)

  drvTicketKnown    Boolean  @default(false)
  drvOrganizationId String?
  drvClientId       String?
  drvGroupId        String?
  drvInternal       Boolean?
  drvPersonId       String?
  drvPersonVia      String?
  drvPmo            Boolean?
  drvTeamId         String?
  drvLevelId        String?
  drvEligibility    String   @default("PENDING_ELIGIBILITY")
  drvBucket         String   @default("NO_TICKET")
  drvFlags          String[] @default([])
  drvVersion        Int      @default(1)
  drvAt             DateTime @default(now())
  drvBatchId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstBatch  UploadBatch        @relation(fields: [firstBatchId], references: [id], onDelete: Restrict)
  corrections ZdTimeCorrection[]

  @@index([ticketId])
  @@index([workDate])
  @@index([drvPersonId])
  @@index([drvClientId])
  @@index([drvBucket])
  @@index([sourceId, ticketId])
  @@index([firstBatchId])
}

/// Corrección explícita de un registro existente: conserva el contenido anterior y el lote que la decidió.
model ZdTimeCorrection {
  id                  BigInt   @id @default(autoincrement())
  entryId             String
  batchId             String
  fingerprint         String
  previousFingerprint String
  previous            Json
  minutesBefore       Decimal
  minutesAfter        Decimal
  reverted            Boolean  @default(false)
  decidedById         String
  createdAt           DateTime @default(now())

  entry     ZdTimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  batch     UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  decidedBy User        @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([batchId])
}

/// Decisión del Administrador sobre una fila con posible corrección: corrige un registro concreto u otro trabajo.
model ZdTimeDecision {
  id             BigInt   @id @default(autoincrement())
  batchId        String
  fingerprint    String
  /// CORRECTION | DIFFERENT
  decision       String
  targetEntryId  String?
  /// Revisión del registro objetivo cuando el Administrador decidió: si cambió después, la decisión queda obsoleta.
  targetRevision Int?
  decidedById    String
  decidedAt      DateTime @default(now())

  batch     UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  decidedBy User        @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([batchId, fingerprint])
}

/// Instantánea de los vínculos derivados de cada fila de un lote de tickets, calculada al preparar, activar o recalcular.
/// La ficha la lee indexada (sin recalcular la derivación por consulta) y avisa si los maestros cambiaron después.
model ZdTicketPreview {
  batchId       String
  position      Int
  ticketId      String
  orgState      String
  clientId      String?
  groupId       String?
  internal      Boolean?
  hosting       String?
  incidentClass String
  incomplete    Boolean

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([batchId, position])
  @@index([batchId, orgState])
}

/// Instantánea del motivo principal y los indicadores de cada fila de un lote de tiempos (solo las que se materializarían).
model ZdTimePreview {
  batchId  String
  position Int
  bucket   String
  flags    String[] @default([])

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([batchId, position])
  @@index([batchId, bucket])
}

/// Huella de los datos de los que depende la instantánea (maestros y tickets) cuando se calculó.
model ZdPreviewStamp {
  batchId    String   @id
  computedAt DateTime @default(now())
  stamp      String

  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------- CSAPP-04: Wrike, PAP y bugs de producto

/// Imputación de Wrike materializada (una por fila fuente distinta de seis campos). Las columnas drv* son derivadas.
/// minutes = hours × 60 exacto; «Dedicación (horas)» nunca se divide entre 60.
model WrikeTimeEntry {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  originFingerprint String   @unique
  firstBatchId      String
  userName          String?
  projectName       String?
  taskName          String
  ticketFieldRaw    String?
  /// NONE | VALID | INVALID: estado sintáctico del campo explícito «Ticket Zendesk».
  explicitState     String
  explicitTicket    String?
  /// Candidatos de ticket del nombre de la tarea: [{id, method, evidence}].
  nameCandidates    Json     @default("[]")
  workDate          DateTime @db.Date
  hours             Decimal
  minutes           Decimal
  fingerprint       String
  revision          Int      @default(1)

  drvTicketId         String?
  drvTicketMethod     String   @default("NONE")
  drvTicketState      String   @default("NONE")
  drvPersonId         String?
  drvPmo              Boolean?
  drvTeamId           String?
  drvLevelId          String?
  drvRoleId           String?
  drvGroupId          String?
  drvClientId         String?
  drvImplementationId String?
  drvScopeMethod      String?
  drvConflict         Boolean  @default(false)
  drvCause            String   @default("UNCLASSIFIED")
  drvEligibility      String   @default("PENDING_ELIGIBILITY")
  drvBucket           String   @default("PENDING_ELIGIBILITY")
  drvFlags            String[] @default([])
  drvVersion          Int      @default(1)
  drvAt               DateTime @default(now())
  drvBatchId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstBatch  UploadBatch           @relation(fields: [firstBatchId], references: [id], onDelete: Restrict)
  corrections WrikeTimeCorrection[]

  @@index([workDate])
  @@index([drvPersonId])
  @@index([drvClientId])
  @@index([drvBucket])
  @@index([drvTicketId])
  @@index([firstBatchId])
}

model WrikeTimeCorrection {
  id                  BigInt   @id @default(autoincrement())
  entryId             String
  batchId             String
  fingerprint         String
  previousFingerprint String
  previous            Json
  minutesBefore       Decimal
  minutesAfter        Decimal
  reverted            Boolean  @default(false)
  decidedById         String
  createdAt           DateTime @default(now())

  entry     WrikeTimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  batch     UploadBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  decidedBy User           @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([batchId])
}

model WrikeTimeDecision {
  id             BigInt   @id @default(autoincrement())
  batchId        String
  fingerprint    String
  decision       String
  targetEntryId  String?
  targetRevision Int?
  decidedById    String
  decidedAt      DateTime @default(now())

  batch     UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  decidedBy User        @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([batchId, fingerprint])
}

/// PAP: una entidad por (lista de origen, ID extraído del título). El resto del título puede cambiar (revisión).
model PapItem {
  id                   String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  listKey              String
  papId                String
  firstBatchId         String
  currentRevisionId    BigInt?
  currentObservationId BigInt?
  /// Ámbito del proyecto a la fecha de producción: CLIENT | IMPLEMENTATION | GROUP_ONLY | NO_PROJECT | UNMAPPED.
  drvScope             String   @default("UNMAPPED")
  drvGroupId           String?
  drvClientId          String?
  drvImplementationId  String?
  /// HOTFIX-02: procedencia del ámbito. IDENTITY (equivalencia directa) | TICKET_ALIAS (alias de varios Grupos resuelto por el ticket vinculado) | NULL.
  drvVia               String?
  drvVersion           Int      @default(1)
  drvAt                DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  firstBatch   UploadBatch      @relation(fields: [firstBatchId], references: [id], onDelete: Restrict)
  revisions    PapRevision[]
  observations PapObservation[]

  @@unique([listKey, papId])
  @@index([firstBatchId])
  @@index([drvClientId])
  @@index([drvGroupId])
}

model PapRevision {
  id                 BigInt    @id @default(autoincrement())
  itemId             String
  fingerprint        String
  revisionNo         Int
  title              String
  project            String?
  result             String?
  requestDate        DateTime? @db.Date
  productionDate     DateTime? @db.Date
  /// CORRECTIVE | NON_CORRECTIVE | UNKNOWN
  correctiveState    String
  /// Todos los campos fuente tipados (29 columnas).
  data               Json
  previousRevisionId BigInt?
  changedFields      String[]  @default([])
  batchId            String
  createdAtDb        DateTime  @default(now())

  item         PapItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch        UploadBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observations PapObservation[]
  causes       PapCause[]
  references   PapReference[]

  @@unique([itemId, fingerprint])
  @@unique([itemId, revisionNo])
  @@index([batchId])
}

model PapObservation {
  id           BigInt   @id @default(autoincrement())
  itemId       String
  batchId      String
  revisionId   BigInt
  observedOn   DateTime @db.Date
  observedKind String
  receivedAt   DateTime
  createdAt    DateTime @default(now())

  item     PapItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch    UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  revision PapRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([batchId, itemId])
  @@index([itemId, observedOn])
  @@index([revisionId])
}

/// Pertenencia de una revisión a una causa (token original y normalizado). Un PAP con varias causas sigue siendo uno.
model PapCause {
  id         BigInt  @id @default(autoincrement())
  revisionId BigInt
  rawToken   String
  normalized String
  /// CORRECTIVE | EVOLUTIVE | MAINTENANCE | OTHER
  category   String
  origin     String?

  revision PapRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, normalized])
}

/// Referencias de una revisión PAP: TICKET_ASSOCIATED, TICKET_PAP, BUG, CAL o TEXT (no interpretable, con motivo).
model PapReference {
  id         BigInt  @id @default(autoincrement())
  revisionId BigInt
  kind       String
  refKey     String
  refId      String?
  product    String?
  rawText    String
  reason     String?

  revision PapRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, kind, refKey])
  @@index([kind, refId])
}

/// Work Item de producto: una entidad por (producto, ámbito DevOps, ID). VFS y VSW nunca se fusionan.
model WorkItem {
  id                   String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  product              String
  scopeKey             String
  workItemId           String
  firstBatchId         String
  currentRevisionId    BigInt?
  currentObservationId BigInt?
  /// Última fotografía que lo contenía (fecha de observación) y su lote.
  lastObservedOn       DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  firstBatch   UploadBatch           @relation(fields: [firstBatchId], references: [id], onDelete: Restrict)
  revisions    WorkItemRevision[]
  observations WorkItemObservation[]
  links        WorkItemLink[]

  @@unique([product, scopeKey, workItemId])
  @@index([product, workItemId])
  @@index([firstBatchId])
}

model WorkItemRevision {
  id                 BigInt    @id @default(autoincrement())
  workItemId         String
  fingerprint        String
  revisionNo         Int
  itemType           String
  isBug              Boolean
  title              String
  state              String
  stateCategory      String
  stateKnown         Boolean
  assignedTo         String?
  createdBy          String?
  /// Hora local de DevOps (sin zona), AAAA-MM-DDTHH:mm:ss; nunca se convierte a un instante UTC inventado.
  createdLocal       String?
  createdDate        DateTime? @db.Date
  changedLocal       String?
  areaPath           String?
  tags               String[]  @default([])
  commentCount       Int?
  reportedBy         String?
  clientsRaw         String?
  zendeskTicketRaw   String?
  previousRevisionId BigInt?
  changedFields      String[]  @default([])
  batchId            String
  createdAtDb        DateTime  @default(now())

  workItem     WorkItem              @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  batch        UploadBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observations WorkItemObservation[]

  @@unique([workItemId, fingerprint])
  @@unique([workItemId, revisionNo])
  @@index([batchId])
  @@index([isBug, stateCategory])
}

/// Presencia en una fotografía: el lote vio este Work Item con esta revisión en la fecha de observación.
model WorkItemObservation {
  id           BigInt   @id @default(autoincrement())
  workItemId   String
  batchId      String
  revisionId   BigInt
  observedOn   DateTime @db.Date
  observedKind String
  receivedAt   DateTime
  createdAt    DateTime @default(now())

  workItem WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  batch    UploadBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  revision WorkItemRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([batchId, workItemId])
  @@index([workItemId, observedOn])
  @@index([revisionId])
}

/// Vínculo Work Item–ticket Zendesk (par único). La evidencia observada por cada carga está en WorkItemLinkEvidence;
/// la decisión manual del Administrador es independiente y no se borra al cambiar un CSV. drv* es la resolución derivada.
model WorkItemLink {
  id            BigInt    @id @default(autoincrement())
  workItemId    String
  ticketId      String
  /// CONFIRMED | REJECTED, solo por revisión explícita auditada.
  manualState   String?
  manualById    String?
  manualAt      DateTime?
  manualNote    String?
  version       Int       @default(1)
  drvState      String    @default("PENDING_TICKET")
  drvTicketType String?
  drvClientId   String?
  drvGroupId    String?
  drvInternal   Boolean?
  drvAt         DateTime  @default(now())
  createdAt     DateTime  @default(now())

  workItem WorkItem               @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  manualBy User?                  @relation(fields: [manualById], references: [id], onDelete: Restrict)
  evidence WorkItemLinkEvidence[]

  @@unique([workItemId, ticketId])
  @@index([ticketId])
  @@index([drvState])
}

model WorkItemLinkEvidence {
  id         BigInt   @id @default(autoincrement())
  linkId     BigInt
  batchId    String
  /// ZENDESK_TICKET_ID (columna explícita) | CLIENTS_URL (URL reconocida en «Clients»).
  source     String
  rawRef     String
  observedOn DateTime @db.Date

  link  WorkItemLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  batch UploadBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([linkId, batchId, source])
  @@index([batchId])
}

// ---------------------------------------------------------------- CSAPP-05: finanzas y motor económico

/// Cabecera financiera de un lote (año + categoría), sus controles, la tolerancia capturada y la revisión del impacto.
/// category: SOPORTE | ADMIN_DELEGADA | OTROS. origin: UPLOAD | HISTORICAL.
model FinanceBatch {
  batchId               String    @id
  year                  Int
  category              String
  origin                String    @default("UPLOAD")
  extractionDate        DateTime? @db.Date
  /// Filtros del pie, hoja, filas de control, verificaciones y declaraciones del lote.
  controls              Json      @default("{}")
  controlIncome         Decimal?  @db.Decimal(38, 20)
  controlDiff           Decimal?  @db.Decimal(38, 20)
  /// Tolerancia monetaria absoluta con la que se validó este lote (capturada de la configuración).
  tolerance             Decimal   @db.Decimal(18, 6)
  settingsRevisionId    BigInt?
  /// Versión del ámbito (año+categoría) cuando se revisó el impacto; si cambia, la revisión es obsoleta.
  reviewedScopeVersion  Int?
  reviewedActiveBatchId String?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewSnapshot        Json?
  /// Huella de los maestros BC con los que se derivó la atribución; si cambia, el recálculo está pendiente.
  derivedStamp          String?
  derivedVersion        Int       @default(1)
  derivedAt             DateTime  @default(now())
  createdAt             DateTime  @default(now())

  batch UploadBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rows  FinanceRow[]

  @@index([year, category])
}

/// Línea económica única del lote (una por huella). income es el valor usado; incomeOriginal conserva el vacío fuente.
model FinanceRow {
  id                 BigInt   @id @default(autoincrement())
  batchId            String
  position           Int
  sourceRow          Int
  groupLabel         String
  sourceKey          String
  fingerprint        String
  occurrences        Int      @default(1)
  incomeOriginal     String?
  income             Decimal? @db.Decimal(38, 20)
  incomeDerivedZero  Boolean  @default(false)
  differenceOriginal String?
  difference         Decimal? @db.Decimal(38, 20)
  /// Atribución derivada (se recalcula sin tocar el dinero).
  groupId            String?
  resolution         String   @default("UNRESOLVED")
  resolutionDetail   Json?
  createdAt          DateTime @default(now())

  batch FinanceBatch @relation(fields: [batchId], references: [batchId], onDelete: Restrict)

  @@unique([batchId, fingerprint])
  @@index([batchId, groupId])
  @@index([batchId, sourceKey])
}

/// Puntero al lote financiero vigente de cada año+categoría. version crece en cada activación o reversión.
model FinanceScope {
  year          Int
  category      String
  activeBatchId String?
  version       Int      @default(1)
  updatedAt     DateTime @default(now())

  @@id([year, category])
}

/// Decisión explícita del Administrador sobre un lote financiero (EMPTY_AS_ZERO, YEAR_ASSIGNMENT, ACCEPT_UNASSIGNED...).
model FinanceDecision {
  id          BigInt   @id @default(autoincrement())
  batchId     String
  kind        String
  key         String   @default("")
  value       Json?
  reason      String?
  decidedById String
  decidedAt   DateTime @default(now())

  batch     UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  decidedBy User        @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([batchId, kind, key])
}

/// Revisión inmutable de la configuración económica (objetivo, jornada, tolerancia).
model EconomicSettingsRevision {
  id                      BigInt   @id @default(autoincrement())
  revisionNo              Int      @unique
  targetEurosPerDay       Decimal  @db.Decimal(18, 6)
  dayHours                Decimal  @db.Decimal(10, 4)
  reconciliationTolerance Decimal  @db.Decimal(18, 6)
  reason                  String?
  activatedAt             DateTime @default(now())
  activatedById           String?

  activatedBy User? @relation(fields: [activatedById], references: [id], onDelete: Restrict)
}

/// Asignación mínima de servicio económico por valor exacto de Entorno y Tipología o por proyecto Wrike, con vigencia.
/// matchKind: ENTORNO | WRIKE_PROJECT. service: SOPORTE | ADMIN_DELEGADA | OTROS.
model ServiceAssignment {
  id          String    @id @default(cuid())
  matchKind   String
  matchValue  String
  searchValue String
  service     String
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  note        String?
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([matchKind, searchValue])
}

/// Revisión inmutable de una familia de configuración tipada (CSAPP-07): PULSE (Pulse Rent) o QUALITY (Calidad). La economía conserva su tabla.
/// `payload` es un contrato versionado y validado en servidor (zod), no un documento de fórmulas. Volver a una anterior crea una NUEVA revisión
/// (kind ROLLBACK, restoredFromRevisionNo). Un disparador impide UPDATE y DELETE.
model ConfigRevision {
  id                     BigInt   @id @default(autoincrement())
  family                 String
  revisionNo             Int
  payload                Json
  reason                 String?
  kind                   String
  restoredFromRevisionNo Int?
  activatedAt            DateTime @default(now())
  activatedById          String?

  activatedBy User? @relation("ConfigRevisionActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)

  @@unique([family, revisionNo])
}

/// Borrador único por familia: editable, simulable y NO activo. `baseRevisionNo` y `version` detectan ediciones obsoletas.
model ConfigDraft {
  id             BigInt   @id @default(autoincrement())
  family         String   @unique
  payload        Json
  baseRevisionNo Int
  version        Int      @default(1)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedById    String?

  updatedBy User? @relation("ConfigDraftUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------- CSAPP-08: Calidad, Client Health y cobertura declarada

/// Feedback mensual de Client Health de UN ámbito (Grupo Cliente o Cliente) y UN mes. Sin fila = sin feedback; `state = 'NONE'` = celda limpiada
/// (el historial se conserva y equivale a «sin feedback», nunca a puntuación cero). No hay arrastre mensual ni propagación entre ámbitos.
/// state: POSITIVE | NEGATIVE | MIXED | NONE. «Mixto» es una elección explícita, no un sentimiento deducido del comentario.
model HealthFeedback {
  id          BigInt    @id @default(autoincrement())
  groupId     String?
  clientId    String?
  year        Int
  month       Int
  state       String
  comment     String?
  /// Fecha concreta del feedback si se conoce. Nula = «fecha dentro del mes no informada» (uso mensual/provisional). No es la fecha de guardado.
  feedbackOn  DateTime? @db.Date
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String

  group     ClientGroup?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  client    Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  updatedBy User                  @relation("HealthUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  history   HealthFeedbackEvent[]

  @@unique([groupId, year, month])
  @@unique([clientId, year, month])
  @@index([year, month])
  @@index([updatedById])
}

/// Historial inmutable de cada cambio de una celda de Client Health (antes/después como columnas; la auditoría general añade el JSON).
model HealthFeedbackEvent {
  id             BigInt    @id @default(autoincrement())
  feedbackId     BigInt
  version        Int
  action         String
  state          String
  comment        String?
  feedbackOn     DateTime? @db.Date
  prevState      String?
  prevComment    String?
  prevFeedbackOn DateTime? @db.Date
  at             DateTime  @default(now())
  byId           String

  feedback HealthFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  by       User           @relation("HealthEventBy", fields: [byId], references: [id], onDelete: Restrict)

  @@unique([feedbackId, version])
  @@index([byId])
}

/// Nota sencilla de revisión de QA sobre un ámbito/periodo/evidencia (DIA 04). No es un gestor de tareas ni de planes de pruebas.
model QualityNote {
  id        BigInt   @id @default(autoincrement())
  groupId   String?
  clientId  String?
  year      Int
  month     Int
  /// Familia de diagnóstico o indicador al que se refiere la nota (texto libre controlado en servidor).
  topic     String
  /// Evidencia vinculada (identificadores de ticket, PAP…); texto, no clave foránea.
  evidence  String?
  text      String
  authorId  String
  createdAt DateTime @default(now())

  group  ClientGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  author User         @relation("QualityNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([groupId, year, month])
  @@index([clientId, year, month])
  @@index([authorId])
}

/// Declaración tipada de cobertura/fotografía de un lote (Administración › Cargas). Versionada y de solo añadir: la vigente es la de mayor versión.
/// No cambia filas, extracción original, observaciones ni estados históricos del lote. Los lotes sin declaración permanecen «desconocidos».
/// population: ALL_CLIENTS | PARTIAL | UNKNOWN. statusScope: ALL_STATUSES | UNRESOLVED_ONLY | NOT_APPLICABLE | UNKNOWN.
model UploadCoverageDeclaration {
  id           BigInt    @id @default(autoincrement())
  batchId      String
  version      Int
  population   String
  statusScope  String
  /// Alcance temporal declarado: fecha de creación (tickets), de trabajo (tiempos) o de producción (PAP) cubierta, ambas inclusivas.
  coveredFrom  DateTime? @db.Date
  coveredTo    DateTime? @db.Date
  /// Fecha de extracción revisada por el Administrador (no sustituye la original del lote ni las observaciones).
  extractedOn  DateTime? @db.Date
  reason       String
  declaredById String
  declaredAt   DateTime  @default(now())

  batch      UploadBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  declaredBy User        @relation("CoverageDeclaredBy", fields: [declaredById], references: [id], onDelete: Restrict)

  @@unique([batchId, version])
  @@index([declaredById])
}

// ---------------------------------------------------------------- CSAPP-09: exportaciones completas y conciliación

enum ExportStatus {
  QUEUED
  PREPARING
  GENERATING
  READY
  FAILED
  CANCELLED
  EXPIRED
}

/// Trabajo persistente de exportación completa (cola en PostgreSQL con lease y fencing, sin Redis). La consulta validada, el solicitante, las versiones,
/// las revisiones de configuración y el sello pedido se guardan al crearlo; al prepararse se MATERIALIZA en una lectura coherente (ExportRow) y el archivo
/// se genera por bloques desde esa materialización inmutable. Cada intento escribe un temporal propio y publica con rename atómico.
model ExportJob {
  id               String       @id @default(uuid())
  ownerId          String
  dataset          String
  query            Json
  status           ExportStatus @default(QUEUED)
  phase            String?
  progressDone     BigInt       @default(0)
  progressTotal    BigInt?
  cancelRequested  Boolean      @default(false)
  formatVersion    String
  engineVersion    String
  configRevisions  Json
  requestedStamp   String
  requestedReadAt  DateTime
  requestedTotals  Json
  /// Materialización: lectura coherente que fija registros, contexto y totales. Nula hasta completarse.
  materializedAt   DateTime?
  materialStamp    String?
  materialContext  Json?
  rowCount         BigInt?
  laterThanScreen  Boolean      @default(false)
  attempts         Int          @default(0)
  maxAttempts      Int          @default(3)
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  heartbeatAt      DateTime?
  fence            Int          @default(0)
  runAfter         DateTime     @default(now())
  lastError        String?
  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  expiresAt        DateTime?

  owner User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  files ExportFile[]

  @@index([ownerId, createdAt])
  @@index([status, runAfter])
  @@index([status, expiresAt])
}

/// Archivo terminado y validado de un trabajo (UUID interno de almacenamiento; nunca ruta ni nombre del navegador).
model ExportFile {
  id        String   @id @default(uuid())
  jobId     String
  fileKey   String
  part      Int      @default(1)
  kind      String
  name      String
  rows      BigInt
  bytes     BigInt
  checksum  String
  additive  Boolean  @default(true)
  storageId String   @unique
  createdAt DateTime @default(now())

  job ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, fileKey, part])
}

/// Materialización inmutable de una exportación: una fila por registro del archivo, con orden estable (seq). Se borra al caducar el trabajo.
model ExportRow {
  jobId   String
  fileKey String
  seq     BigInt
  cells   Json

  @@id([jobId, fileKey, seq])
}

/// Ejecución registrada de una comprobación de conciliación (Administración): parámetros, resultados y manifiesto de lo leído. No modifica fuentes.
model ReconRun {
  id          String   @id @default(uuid())
  actorId     String
  params      Json
  stamp       String
  readAt      DateTime
  results     Json
  manifest    Json
  summary     Json
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

// ---------------------------------------------------------------- CSAPP-10: operación (latido por trabajador, identidad de instalación)

enum WorkerState {
  IDLE
  BUSY
  STOPPING
  STOPPED
}

/// Latido por trabajador, en reposo o procesando (CSAPP-10 §4). La ausencia de trabajos recientes ya no se toma como prueba de que esté caído.
model WorkerInstance {
  id              String      @id
  pid             Int
  host            String
  version         String
  sha             String
  state           WorkerState @default(IDLE)
  /// Trabajo en curso (tipo `upload:PREPARE`, `export:GENERATING`…) e identificador; nulo en reposo.
  currentKind     String?
  currentJobId    String?
  currentBatchId  String?
  /// Último avance observable del trabajo en curso (cada bloque); permite distinguir «presente pero sin avanzar».
  progressAt      DateTime?
  startedAt       DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())
  stoppedAt       DateTime?
  /// Petición de cierre ordenado (multiplataforma: no depende de señales POSIX).
  stopRequestedAt DateTime?

  @@index([lastSeenAt])
}

/// Metadatos clave/valor de la instalación (identificador estable que enlaza base y almacenes privados).
model InstallationMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

// ================================================================ CSAPP-HOTFIX-01: precarga de maestros (bloque propio, al final) ====

/// Decisión del administrador sobre una revisión de la precarga de maestros. Ligada al checksum del archivo y a una clave de CONTENIDO
/// (nunca al número de fila). Sin relaciones a propósito (ver la migración): no altera UploadBatch ni User.
model MasterLoadDecision {
  id             String   @id @default(cuid())
  batchId        String
  checksum       String
  reviewKey      String
  kind           String
  decision       String
  payload        Json     @default("{}")
  reason         String
  decidedById    String
  decidedByEmail String
  decidedAt      DateTime @default(now())

  @@unique([batchId, reviewKey])
  @@index([checksum, reviewKey])
}

// ======================================================================================================================
// HOTFIX-01 §6-§7 (bloque propio; migración 20261108090000_hotfix01_historico_usuarios). Sin claves foráneas a tablas existentes
// para no tocar sus modelos: los identificadores son los del maestro y se validan en servidor.
// ======================================================================================================================

/// Grupo Cliente creado por la precarga del histórico económico porque no estaba en el maestro (sin Cliente, IDs, implantaciones ni usuarios inventados).
/// Su estado comercial actual NO se deduce de su ausencia en CLIENTES.
model HistoricGroupOrigin {
  groupId       String   @id
  /// Lote de carga (libro) que lo originó.
  sourceBatchId String
  originalLabel String
  note          String
  createdAt     DateTime @default(now())

  @@index([sourceBatchId])
}

/// Valor de usuarios de 2025 (columna H) por Grupo y categoría, tal como figura en el libro. Dos categorías con valores distintos son una discrepancia
/// que no se resuelve por máximo, suma ni último: exige elección explícita (HistoricUserResolution).
model HistoricUserBase {
  groupId     String
  year        Int
  category    String
  value       Int
  sourceRow   Int
  sourceCell  String
  /// El valor procede de una fórmula aritmética con resultado almacenado (nunca se ejecuta).
  fromFormula Boolean  @default(false)
  batchId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([groupId, year, category])
  @@index([batchId])
}

/// Elección explícita del Administrador entre los valores en discrepancia (o valor indicado) de un Grupo y año base.
model HistoricUserResolution {
  groupId     String
  year        Int
  /// Categoría elegida; nulo si el valor se escribió expresamente.
  category    String?
  value       Int
  reason      String?
  decidedById String
  decidedAt   DateTime @default(now())

  @@id([groupId, year])
}

// ======================================================================================================================
// CSAPP-HOTFIX-02 · enlace automático de datos (bloque delimitado; modelos añadidos al final)
// ======================================================================================================================

/// Estado verificable de la actualización de relaciones. Una fila por ámbito (`global`). `requestedGeneration` lo incrementan disparadores de la
/// base ante cualquier cambio de maestros (Grupos, Clientes, implantaciones, equivalencias, datos de servicio, personas, alias y tramos): no se
/// pierde un cambio que llega durante un recálculo. El trabajador toma la generación al empezar y solo publica `completedGeneration` hasta ella.
model RelationRefresh {
  scope               String    @id
  requestedGeneration BigInt    @default(0)
  completedGeneration BigInt    @default(0)
  /// IDLE | PENDING | RUNNING | FAILED
  status              String    @default("IDLE")
  reason              String?
  requestedAt         DateTime?
  requestedById       String?
  startedAt           DateTime?
  finishedAt          DateTime?
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  runAfter            DateTime  @default(now())
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  fence               Int       @default(0)
  /// Progreso visible de la ejecución en curso: {phase, step, steps}.
  progress            Json?
  lastError           String?
  /// Informe de la última ejecución completa (conteos antes/después y clasificación de coincidencias; sin nombres).
  lastReport          Json?
  updatedAt           DateTime  @default(now()) @updatedAt
}

/// Grupos candidatos de un alias (Wrike/PAP) que el libro de Clientes asigna a VARIOS Grupos. No es una equivalencia: no atribuye por sí sola. Solo
/// permite resolver un hecho cuando su propio registro (ticket vinculado y organización) identifica un único candidato compatible. Sin FK a propósito.
model AliasCandidate {
  id          String         @id @default(cuid())
  system      ExternalSystem
  kind        IdentityKind
  rawValue    String
  searchValue String
  groupId     String
  batchId     String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@unique([system, kind, searchValue, groupId])
  @@index([system, kind, searchValue])
}
